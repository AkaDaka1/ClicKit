# Контекст сборки образов ClicKit (см. plans/M6-docker.md §4.4).
# Windows-движок Docker Desktop собирает образом legacy-билдером без BuildKit,
# поэтому фильтрация контекста — только через этот файл: dist/ достигает 1 ГБ.
.git/
.github/
docker/
plans/
dist/
build/
reports/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.log
*.zip
SHA256SUMS.txt

# Секреты и локальные данные не должны попадать даже в контекст сборки.
.env
.env.*
!.env.example
settings.local.json
*.local.json
scratch/

# Отчёты тестов и покрытия (в образ не нужны).
.coverage
.coverage.*
coverage.xml
htmlcov/
