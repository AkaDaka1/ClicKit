# Пример локальной конфигурации ClicKit Cloud (M7 T4.1).
# Скопируйте файл в .env (он в .gitignore) и замените значения.
# Секреты в репозиторий не попадают: здесь только заготовки.

# Ключ записи (POST/DELETE), не короче 16 символов.
CLICKIT_API_KEY=change-me-at-least-16-chars

# Ключ удаления. Пусто — DELETE разрешён write-ключом; заполните (≥ 16 символов),
# чтобы требовать отдельный admin-ключ.
CLICKIT_ADMIN_API_KEY=

# Пароль PostgreSQL. Используется и в строке подключения, поэтому избегайте
# символов @ : / ? # % — иначе URL придётся кодировать вручную.
POSTGRES_PASSWORD=change-me-local-password

# Порт API на хосте (в контейнере всегда 8000).
CLICKIT_API_PORT=8000

# Уровень журнала: DEBUG, INFO, WARNING, ERROR, CRITICAL.
CLICKIT_LOG_LEVEL=INFO
